---
import { home } from '../content/home';
import { site } from '../content/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (h: string) => `${base}/${h}`;
---
<header class="header" data-header>
  <div class="header__bar glass">
    <a class="brand" href={`${base}/`} aria-label={`${site.name} — home`}>{site.name}</a>
    <nav class="nav" aria-label="Primary">
      {home.nav.map((i) => <a href={href(i.href)}>{i.label}</a>)}
    </nav>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
      <i aria-hidden="true"></i><span data-menu-label>Menu</span>
    </button>
  </div>
</header>
<div class="menu-panel" id="menu" data-menu-panel aria-hidden="true" inert>
  <nav aria-label="Mobile">
    {home.nav.map((i, n) => <a class="menu-link" style={`transition-delay:${0.06 * n + 0.1}s`} href={href(i.href)}>{i.label}</a>)}
  </nav>
  <p class="label">{site.email}</p>
</div>
