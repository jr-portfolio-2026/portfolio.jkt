---
import { home } from '../content/home';
const f = home.fields;
---
<section class="section fields" id="fields">
  <div class="container">
    <div class="section-head reveal"><p class="label">{f.label}</p><h2 class="display">{f.title}</h2></div>
    <div>
      {f.items.map((i) => (
        <article class="field reveal">
          <h3>{i.title}</h3>
          <p>{i.text}</p>
          <ul>{i.tags.map((t) => <li>{t}</li>)}</ul>
        </article>
      ))}
    </div>
  </div>
</section>
