{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite dev",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/check-placeholders.mjs",
    "check:dist": "node scripts/verify-dist.mjs",
    "build:release": "node scripts/check-placeholders.mjs --strict && npm run build",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.0",
    "@fontsource/cormorant-garamond": "^5.2.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-router": "1.170.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "lucide-react": "^0.575.0",
    "motion": "^13.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "1.168.23",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "vite": "8.1.5"
  }
}
